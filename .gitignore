# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Node — pattern matches every nested node_modules across all workspaces
node_modules/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Wrangler / Miniflare local state
cloudflare/.wrangler/

# Expo / Metro
.expo/
.expo-shared/
mobile/dist/
mobile/web-build/
mobile/ios/
mobile/android/
mobile/builds/
*.ipa

# Next.js
frontend/.next/
# Browser engine build output (scripts/engine/wasm-build.mjs, web-worker-build.mjs)
frontend/public/wasm/
frontend/public/workers/snapshot.js
frontend/out/
frontend/build/

# TypeScript build info
*.tsbuildinfo

# Env
.env
.env.local
.env.*.local

# Local FitNotes sample DBs / exports (not tracked; synthetic CSV lives in tests/fixtures/)
test_dbs/

# Rust build outputs and local performance reports
/target/
/benchmarks/local/
/.ccache/
/mobile/modules/lift-engine/ios/Generated/
/mobile/modules/lift-engine/android/generated/

# Local Expo module Gradle outputs
/mobile/modules/*/android/build/
