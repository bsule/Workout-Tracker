{
  "name": "lift-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "frontend",
    "mobile",
    "cloudflare"
  ],
  "scripts": {
    "dev:web": "npm --workspace lift-client run dev",
    "build:web": "npm --workspace lift-client run build",
    "dev:mobile": "npm --workspace lift-mobile run start",
    "dev": "concurrently -n web,mobile -c cyan,magenta --kill-others --kill-signal SIGINT \"npm:dev:web\" \"npm:dev:mobile\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "engine:baseline": "vitest run --config scripts/engine/vitest.config.mts",
    "engine:oracle": "node scripts/engine/units-oracle.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "fake-indexeddb": "^6.2.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "react-native-worklets": "0.13.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "unrs-resolver": true,
    "workerd": true
  }
}
