{
  "name": "lift-mobile",
  "version": "0.0.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:devclient": "expo start --dev-client",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "prebuild": "expo prebuild --platform ios --clean",
    "typecheck": "tsc --noEmit",
    "build:ios": "eas build --platform ios --profile preview --non-interactive",
    "build:ios:prod": "eas build --platform ios --profile production --non-interactive",
    "build:android": "eas build --platform android --profile preview --non-interactive",
    "build:android:prod": "eas build --platform android --profile production --non-interactive",
    "ipa": "node scripts/download-ipa.mjs",
    "ipa:pick": "node scripts/download-ipa.mjs --pick",
    "ipa:gh": "node scripts/github-ipa.mjs",
    "apk:gh": "node scripts/github-apk.mjs",
    "icons": "node scripts/build-icon.mjs",
    "engine:prepare:ios": "node ../scripts/engine/prepare-native.mjs ios",
    "engine:prepare:android": "node ../scripts/engine/prepare-native.mjs android",
    "eas-build-post-install": "node ../scripts/engine/eas-prepare.mjs"
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^6.0.2",
    "@lift/core": "*",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "babel-preset-expo": "~58.0.0",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.19",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-linear-gradient": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "react": "19.3.0",
    "react-hook-form": "^7.88.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "~2.1.0",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "rest-timer": "file:./modules/rest-timer",
    "sql.js": "^1.15.2",
    "zod": "^4.4.3",
    "lift-engine": "file:./modules/lift-engine"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-native-async-storage/async-storage"
      ]
    }
  }
}
